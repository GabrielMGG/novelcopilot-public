# Controle da imagem. Use "latest" no staging ou uma tag sha-... para fixar uma versao.
IMAGE_TAG=latest

# Banco MySQL externo (Aiven)
SPRING_DATASOURCE_URL=jdbc:mysql://host:porta/banco?sslMode=REQUIRED
DB_USER=usuario
DB_PASSWORD=troque-por-uma-senha-real

# Supabase Auth
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=troque-pela-chave-anon
ADMIN_USER_IDS=

# Origem publica exata do frontend, sem barra final
APP_FRONTEND_URL=https://seu-frontend.example

# IA principal
AI_PROVIDER=cloudflare
AI_PRIMARY_MODEL=@cf/google/gemma-4-26b-a4b-it
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=
CLOUDFLARE_SUMMARY_ACCOUNT_ID=
CLOUDFLARE_SUMMARY_AUTH_TOKEN=
AI_SUMMARY_PROVIDER=cloudflare
AI_SUMMARY_MODEL=@cf/google/gemma-4-26b-a4b-it
AI_SUMMARY_MAX_OUTPUT_TOKENS=1400

# Provedores opcionais; podem permanecer vazios enquanto desativados
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=

# Protecoes de staging
AI_BENCHMARK_ENABLED=false
AI_DEVELOPMENT_CREDITS_ENABLED=false
AI_RATE_LIMIT_ENABLED=true
SPRING_JPA_SHOW_SQL=false
SHUTDOWN_TIMEOUT=20s
